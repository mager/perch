PERCH_URL=https://your-perch.vercel.app
PERCH_MACHINE_ID=mac-mini
PERCH_AGENT_TOKEN=matching-machine-token-from-your-server
PERCH_INTERVAL_SECONDS=60
# Optional absolute tmux path if it is not in the agent's PATH.
PERCH_TMUX_PATH=/opt/homebrew/bin/tmux
# Optional: include only this machine's Tailscale state, MagicDNS name, and IPs.
# These private addresses are stored in your hosted Redis snapshot. No peers or keys.
PERCH_TAILSCALE=0
# Optional executable path when tailscale is not in the LaunchAgent's PATH.
# PERCH_TAILSCALE_PATH=/absolute/path/to/tailscale
