# Web origin, no trailing slash. Use http://localhost:8787 for local development.
PERCH_ORIGIN=https://your-perch.vercel.app
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# A verified Gmail / Workspace address. For other providers use OWNER_GOOGLE_SUB.
OWNER_EMAIL=you@gmail.com
# Recommended: pin Google's stable account identifier (email can be reassigned).
# Takes precedence over OWNER_EMAIL. Changing owner/origin/client starts empty storage.
OWNER_GOOGLE_SUB=
# Generate separately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Each ID gets an independent random token of at least 32 characters.
PERCH_MACHINES={"mac-mini":{"name":"Mac mini","token":"replace-with-a-unique-random-token-at-least-32-characters"}}
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
